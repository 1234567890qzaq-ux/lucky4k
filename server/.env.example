# Get a token at https://replicate.com/account/api-tokens  (billing must be enabled)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxx
# Version id of nightmareai/real-esrgan, see README for how to fetch it
REPLICATE_MODEL_VERSION=
PORT=8787
# Input is downscaled to this long edge before upscaling (keeps GPU memory safe)
MAX_INPUT_EDGE=1280
RATE_LIMIT_PER_MIN=120
